# Copie ce fichier en ".env" et remplis-le. Il reste sur TON ordinateur.
STEAM_PROFILE=https://steamcommunity.com/id/quarantdeux/
# Clé gratuite : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
CURRENCY=3            # 3 = EUR, 1 = USD
PORT=3000

# --- Optionnel : nécessaire seulement pour ENVOYER des échanges ---
STEAM_ACCOUNT=
STEAM_PASSWORD=
# Si tu n'as pas de shared_secret, laisse vide : le code Steam Guard sera demandé dans l'interface.
STEAM_SHARED_SECRET=
# Pour confirmer automatiquement l'offre sur ton mobile (optionnel)
STEAM_IDENTITY_SECRET=
